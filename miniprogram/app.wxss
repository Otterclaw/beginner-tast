page {
  background-color: #f0f2f5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.btn-primary {
  background: #1565C0;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  padding: 0 40rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: #1565C0;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: 2rpx solid #1565C0;
  padding: 0 40rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-secondary::after {
  border: none;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}
