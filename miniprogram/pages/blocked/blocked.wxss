.container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
  background: #f0f2f5;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 48rpx;
  text-align: center;
  width: 100%;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.icon {
  display: block;
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}

.desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 40rpx 0;
}

.contact-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.contact-value {
  display: block;
  font-size: 28rpx;
  color: #1565C0;
  font-weight: 500;
}
