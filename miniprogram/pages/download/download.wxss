.intro-card {
  margin-bottom: 24rpx;
}

.intro-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1565C0;
  margin-bottom: 12rpx;
}

.intro-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.option-card {
  margin-bottom: 24rpx;
}

.option-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.option-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.option-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  gap: 12rpx;
}

.option-item.active {
  border-color: #1565C0;
  background: #E3F2FD;
}

.option-icon {
  font-size: 48rpx;
}

.option-text {
  font-size: 26rpx;
  color: #333;
}

.year-select-row {
  margin-top: 8rpx;
}

.picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  color: #999;
  transform: rotate(90deg);
  display: inline-block;
}

.preview-card {
  margin-bottom: 24rpx;
}

.preview-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.col-scroll {
  white-space: nowrap;
}

.col-list {
  display: flex;
  gap: 12rpx;
}

.col-chip {
  display: inline-block;
  background: #E3F2FD;
  color: #1565C0;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.export-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.result-card {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2E7D32;
  margin-bottom: 12rpx;
}

.result-hint {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.save-file-btn {
  width: 100%;
}
