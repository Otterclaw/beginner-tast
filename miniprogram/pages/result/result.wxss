.tip-bar {
  background: #E3F2FD;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #1565C0;
}

.thumb-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
}

.thumb {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.thumb-hint {
  font-size: 24rpx;
  color: #999;
}

.form-card {
  margin-bottom: 24rpx;
}

.form-section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1565C0;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #E3F2FD;
}

.field-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 16rpx 0;
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  font-size: 28rpx;
  color: #333;
  width: 180rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.field-label.required::after {
  content: ' *';
  color: #e53935;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.picker-view {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #bbb;
}

.picker-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
  transform: rotate(90deg);
  display: inline-block;
}

.field-readonly {
  background: transparent;
}

.field-value-readonly {
  flex: 1;
  font-size: 28rpx;
  color: #999;
  text-align: right;
}

.save-btn {
  width: 100%;
  margin-top: 8rpx;
}
